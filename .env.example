# ==============================================================================
# CodeSync AI - Centralized Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Supabase / Neon / Local Docker)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hyodgoxbwgxfunuiavhb.supabase.co:5432/postgres

# Redis Connection (Upstash / Local Docker)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (min 32 characters)
JWT_ACCESS_SECRET=super_secret_access_key_min_32_characters_for_codesync_ai
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_for_codesync_ai
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider Configuration (Supports OpenAI, Google Gemini, Groq, OpenRouter)
# Option A: Official OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini (Free at aistudio.google.com)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=AIzaSy...

# Option C: Groq (Ultra-fast & Free at console.groq.com)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=gsk_...

# Object Storage (AWS S3 / MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=codesync-snapshots
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 2. WORKER PROCESS CONFIGURATION (worker/.env)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
