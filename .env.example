# ==============================================================================
# CodeSync AI - Centralized Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Supabase / Neon / Local Docker)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hyodgoxbwgxfunuiavhb.supabase.co:5432/postgres

# Redis Connection (Upstash / Local Docker)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (min 32 characters)
JWT_ACCESS_SECRET=super_secret_access_key_min_32_characters_for_codesync_ai
JWT_REFRESH_SECRET=super_secret_refresh_key_min_32_characters_for_codesync_ai
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI API Key (For Review, Debug, Explain & RAG Embeddings)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Object Storage (AWS S3 / MinIO)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=codesync-snapshots
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 2. WORKER PROCESS CONFIGURATION (worker/.env)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
