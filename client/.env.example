# ==============================================================================
# CodeSync AI Frontend Client - Environment Configuration (.env)
# ==============================================================================

# In local development:
# Points to local backend server
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# In production (e.g. Vercel deployment):
# Set to your deployed Render/backend service URL:
# VITE_API_URL=https://codesync-api.onrender.com/api/v1
# VITE_SOCKET_URL=https://codesync-api.onrender.com
