# ==============================================================================
# CodeSync AI Worker Process Environment Configuration (.env)
# ==============================================================================

NODE_ENV=development

# Redis Connection (BullMQ Queue: Local Docker or Upstash)
REDIS_URL=redis://localhost:6379

# PostgreSQL Database (Supabase / Neon / Local Docker)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.hyodgoxbwgxfunuiavhb.supabase.co:5432/postgres

# OpenAI API Key (Optional for RAG background indexing)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Docker Daemon Socket (Linux / macOS: /var/run/docker.sock, Windows: //./pipe/docker_engine)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Worker concurrency (Default: 5)
WORKER_CONCURRENCY=5
