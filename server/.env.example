# ==============================================================================
# CodeSync AI Backend Server - Environment Configuration (.env)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated for multiple origins, e.g. production Vercel domain + localhost)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Supabase / Neon / AWS RDS / Local Docker)
# In production, ensure SSL connection parameters if connecting to cloud providers
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.hyodgoxbwgxfunuiavhb.supabase.co:5432/postgres

# Redis Connection (Upstash / Local Docker)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=f0c143d95a537538db128eb0cce9b00307689449de472263c35a44aa95263f46
JWT_REFRESH_SECRET=04435099567e289ccc1ed92b5b99f0cec1a397ef6b4e61118977841c2e0222b5
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# AI Provider Configuration (OpenAI SDK Compatible)
# ------------------------------------------------------------------------------
# Option A: Official OpenAI
# OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option B: Groq (High Speed & Free Tier)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=gsk_...

# Option C: Google Gemini (OpenAI Compatibility Endpoint)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# Object Storage (AWS S3 / MinIO / Cloudflare R2)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=codesync-snapshots
# AWS_S3_ENDPOINT=http://localhost:9000   # Omit for real AWS S3; required for MinIO
# AWS_S3_FORCE_PATH_STYLE=true           # Required for MinIO
